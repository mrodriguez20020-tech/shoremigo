# Copy to .env.local and fill in. Never commit .env.local.

# ── PayPal (SANDBOX ONLY) ─────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → create app.
# The client id is public (it's sent to the browser for the PayPal button);
# the secret stays on the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── LLM (Google Gemini) ───────────────────────────────────────────
# aistudio.google.com → Get API key. Without it, Migo runs in a clearly
# labeled deterministic "offline mode" that uses the same approved tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT_MS=20000
# Comma-separated models tried if the primary is retired (404) or overloaded (429/503)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# ── Security ─────────────────────────────────────────────────────
# 16+ random chars; signs the booking-verification cookie. Required in production.
SESSION_SECRET=
# If set, /operator requires this passcode. Leave empty only for local demos.
OPERATOR_PASSCODE=

# ── Demo options ─────────────────────────────────────────────────
# true = skip the operator review step in Trip Rescue (single-presenter demos).
RESCUE_SKIP_OPERATOR_REVIEW=false

# ── Storage ──────────────────────────────────────────────────────
# Postgres connection string (Supabase or Neon). REQUIRED on Vercel: serverless
# instances do not share a disk. With Supabase use the transaction pooler
# URL (port 6543). The table is created automatically on first use.
DATABASE_URL=
# Local JSON store location when DATABASE_URL is empty (defaults to ./.data).
SHOREMIGO_DATA_DIR=
